        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/firewallRules', format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix')), 'AllowAzureServices')]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers/databases', format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix')), variables('databaseName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-pull-{1}', parameters('namePrefix'), variables('suffix')))]"
