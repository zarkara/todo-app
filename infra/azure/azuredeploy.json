        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-pull-{1}', parameters('namePrefix'), variables('suffix'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env-{1}', parameters('namePrefix'), variables('suffix')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": false,
            "targetPort": 4000,
            "transport": "http"
          },
          "registries": [
            {
              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-pull-{1}', parameters('namePrefix'), variables('suffix')))]"
            }
          ],
          "secrets": [
            {
              "name": "database-url",
              "value": "[format('postgres://{0}:{1}@{2}:5432/{3}', uriComponent(parameters('postgresAdminLogin')), uriComponent(parameters('postgresAdminPassword')), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-pg-{1}', parameters('namePrefix'), variables('suffix'))), '2024-08-01').fullyQualifiedDomainName, variables('databaseName'))]"
            },
            {
              "name": "jwt-secret",
              "value": "[parameters('jwtSecret')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "api",
              "image": "[format('{0}/{1}', reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer, parameters('apiImage'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "PORT",
                  "value": "4000"
                },
                {
                  "name": "DATABASE_URL",
                  "secretRef": "database-url"
                },
                {
                  "name": "DATABASE_SSL",
                  "value": "verify-full"
                },
                {
                  "name": "JWT_SECRET",
                  "secretRef": "jwt-secret"
                },
                {
                  "name": "TRUST_PROXY_HOPS",
                  "value": "[string(parameters('trustProxyHops'))]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 4000
                  },
                  "periodSeconds": 10
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/ready",
                    "port": 4000
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                }
              ]
            }
          ],
          "scale": {
