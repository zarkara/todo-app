      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 10
    },
    "trustProxyHops": {
      "type": "int",
      "defaultValue": 3,
      "metadata": {
        "description": "Proxies in front of the API: the external ingress, nginx and the API's internal ingress."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "apiAppName": "[format('{0}-api', parameters('namePrefix'))]",
    "webAppName": "[format('{0}-web', parameters('namePrefix'))]",
    "databaseName": "todo",
