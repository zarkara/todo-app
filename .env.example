# Copy to .env for `npm run dev`. docker compose works without it (same values are its defaults).
NODE_ENV=development
DATABASE_URL=postgres://todo:todo@localhost:5432/todo
# disable | require | verify-full (production requires require or verify-full; verify-full can take DATABASE_SSL_CA_FILE)
DATABASE_SSL=disable
JWT_SECRET=dev-only-secret-replace-me-in-production
DEMO_USERS=demo@example.com:password123,grace@example.com:password123
PORT=4000
# Set to the number of reverse proxies in front of the API (0 when the browser talks to it directly).
TRUST_PROXY_HOPS=0
